# Resend (https://resend.com) — used to send Request a Quote / Become a Driver
# notification emails and confirmation emails. Free tier is enough to start.

# Your Resend API key (Dashboard -> API Keys)
RESEND_API_KEY=

# The "from" address emails are sent as. Must be on a domain verified in
# Resend, e.g. "Iron Bridge Mobility Solutions <quotes@ironbridgemobility.com>".
# Until you verify your own domain, Resend's shared onboarding@resend.dev
# sender works for testing (it just looks less professional to recipients).
EMAIL_FROM="Iron Bridge Mobility Solutions <onboarding@resend.dev>"

# Business inbox that receives Request a Quote submissions.
QUOTE_NOTIFICATIONS_EMAIL=

# Business inbox that receives Become a Driver applications.
# Falls back to QUOTE_NOTIFICATIONS_EMAIL if not set.
DRIVER_NOTIFICATIONS_EMAIL=

# Site URL (SEO)
# The production URL once the site has a domain, e.g. https://www.ironbridgemobility.com
# Used for sitemap.xml, robots.txt, and Open Graph/social preview links.
# Leave as-is for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps (https://console.cloud.google.com) — powers the interactive
# Service Area map on the homepage and /service-area page. Requires a
# billing-enabled Cloud project with the "Maps JavaScript API" enabled;
# Google's $200/month free credit comfortably covers this site's traffic.
# Restrict the key to your domain(s) under API key settings.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
